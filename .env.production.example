# ==============================================================================
# ProspIX — Variáveis de Ambiente para PRODUÇÃO (Vercel)
# ==============================================================================
# Configurar diretamente no Vercel Dashboard → Settings → Environment Variables.
# Este arquivo serve como referência das vars necessárias.
# ==============================================================================

NODE_ENV=production

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://yvbyplzfqfrlfujathii.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://yvbyplzfqfrlfujathii.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CRON_SECRET=
DISCOVERY_RATE_LIMIT_SALT=

# ── WhatsApp · Evolution API ──────────────────────────────────────────────────
# O target de produção deve vir do canal ativo em whatsapp_channels (VPS atual).
EVOLUTION_BASE_URL=
EVOLUTION_GUILDS_INSTANCE=guilds_master
EVOLUTION_GUILDS_API_KEY=
WHATSAPP_NUMBER_CHECK_COST_MICROS=0
WHATSAPP_MESSAGE_COST_MICROS=0
GOOGLE_MAPS_TEXT_SEARCH_COST_MICROS=0
GOOGLE_MAPS_PLACE_DETAILS_COST_MICROS=0
CNPJA_SEARCH_COST_MICROS=0
TAVILY_SEARCH_COST_MICROS=0
APIFY_INSTAGRAM_COST_MICROS=0
INFOSIMPLES_PHONE_COST_MICROS=0
FIRECRAWL_SCRAPE_COST_MICROS=0
ESCAVADOR_SEARCH_COST_MICROS=0

# ── IA ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4o-mini-2024-07-18
OPENAI_MODEL_CLASSIFIER=gpt-4o-mini-2024-07-18
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FALLBACK=claude-3-5-haiku-20241022
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL_FALLBACK=gemini-1.5-flash

# ── Google OAuth (Calendar) ──────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Secrets vault (AES-256-GCM) ──────────────────────────────────────────────
SECRETS_ENCRYPTION_KEY=

# ── Observabilidade ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LOGIN_URL=/login
NEXT_PUBLIC_WEB_URL=https://www.prospix.com.br
NEXT_PUBLIC_APP_URL=https://app.prospix.com.br
NEXT_PUBLIC_DEMO_MODE=false
