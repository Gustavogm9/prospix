{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.example", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"],
      "env": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "CRON_SECRET",
        "API_URL",
        "EVOLUTION_BASE_URL",
        "EVOLUTION_GUILDS_API_KEY",
        "EVOLUTION_GUILDS_INSTANCE",
        "WAHA_BASE_URL",
        "WAHA_API_KEY",
        "WA_POST_RECONNECT_QUARANTINE_MINUTES",
        "ADMIN_REPORT_EVOLUTION_BASE_URL",
        "ADMIN_REPORT_EVOLUTION_API_KEY",
        "SECRETS_ENCRYPTION_KEY",
        "ALLOW_LEGACY_PLAINTEXT_SECRETS",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_OAUTH_STATE_SECRET",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_LOGIN_URL",
        "NEXT_PUBLIC_WEB_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_DEMO_MODE",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
        "NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA",
        "INVITATION_CODE_TTL_DAYS",
        "VERCEL_ENV",
        "VALIDATE_PRODUCTION_ENV",
        "DISCOVERY_RATE_LIMIT_SALT",
        "GOOGLE_MAPS_TEXT_SEARCH_COST_MICROS",
        "GOOGLE_MAPS_PLACE_DETAILS_COST_MICROS",
        "CNPJA_SEARCH_COST_MICROS",
        "TAVILY_SEARCH_COST_MICROS",
        "APIFY_INSTAGRAM_COST_MICROS",
        "INFOSIMPLES_PHONE_COST_MICROS",
        "FIRECRAWL_SCRAPE_COST_MICROS",
        "ESCAVADOR_SEARCH_COST_MICROS",
        "WHATSAPP_NUMBER_CHECK_COST_MICROS",
        "WHATSAPP_MESSAGE_COST_MICROS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:multi-tenant": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
